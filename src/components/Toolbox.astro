---
import { ui, toolbox, type Lang } from "../data/content";
import { t } from "../lib/i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui.sections.stack;
---

<section id="stack" class="band">
  <div class="shell">
    <SectionHead
      index={s.index}
      label={t(s.label, lang)}
      title={t(s.title, lang)}
      lead={t(s.lead, lang)}
      aside={t(s.aside, lang)}
      kinetic={false}
    />

    <div class="mt-12 flex flex-col">
      {
        toolbox.map((group, i) => (
          <div class="reveal grid gap-4 border-t border-line py-6 lg:grid-cols-[14rem_minmax(0,1fr)]" data-delay={i * 60}>
            <h3 class="t-mono text-ink">{t(group.group, lang)}</h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="chip" translate="no">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

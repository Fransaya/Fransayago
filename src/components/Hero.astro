---
import { ui, profile, tickerItems, type Lang } from "../data/content";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const headline = t(ui.hero.headline, lang);
const items = tickerItems[lang];
---

<section id="top" data-hero class="relative isolate overflow-hidden pt-28 lg:pt-32">
  <canvas
    data-hero-field
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-90"></canvas>

  <div class="shell">
    <!-- meta strip -->
    <div
      data-hero-fade
      class="flex flex-wrap items-center gap-x-6 gap-y-2 border-b border-line pb-4 opacity-0"
      style="transform: translateY(12px)"
    >
      <span class="t-mono flex items-center gap-2">
        <span class="dot dot--live" aria-hidden="true"></span>
        {t(ui.hero.status, lang)}
      </span>
      <span class="t-mono">{t(profile.location, lang)}</span>
      <span class="t-mono ml-auto">{t(ui.hero.since, lang)}</span>
    </div>

    <!-- headline -->
    <h1 class="t-mega mt-10 lg:mt-14">
      <span class="sr-only">{profile.fullName}, {t(ui.hero.role, lang)}. </span>
      {
        headline.map((line, i) => (
          <span class="line-mask">
            <span style={`transition-delay:${i * 90}ms`}>
              {i === headline.length - 1 ? (
                <>
                  {line.slice(0, -1)}
                  <span class="text-signal">.</span>
                </>
              ) : (
                line
              )}
            </span>
          </span>
        ))
      }
    </h1>

    <!-- lead + cta -->
    <div class="mt-12 grid gap-10 border-t border-line pt-8 lg:mt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] lg:gap-16">
      <div data-hero-fade class="opacity-0" style="transform: translateY(12px)">
        <p class="t-mono mb-4">{t(ui.hero.role, lang)}</p>
        <p class="t-lead">{t(ui.hero.lead, lang)}</p>
      </div>

      <div
        data-hero-fade
        class="flex flex-col items-start gap-5 opacity-0 lg:items-end"
        style="transform: translateY(12px)"
      >
        <div class="flex flex-wrap gap-3">
          <a href="#cases" class="btn">
            {t(ui.hero.ctaPrimary, lang)}
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href="#contact" class="btn btn--ghost">{t(ui.hero.ctaSecondary, lang)}</a>
        </div>

        <ul class="flex flex-wrap gap-x-6 gap-y-1 lg:justify-end">
          <li class="t-mono">
            <a class="transition-colors hover:text-signal" href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li class="t-mono">
            <a class="transition-colors hover:text-signal" href={profile.github} target="_blank" rel="noopener noreferrer"
              >GitHub ↗</a
            >
          </li>
          <li class="t-mono">
            <a class="transition-colors hover:text-signal" href={profile.linkedin} target="_blank" rel="noopener noreferrer"
              >LinkedIn ↗</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ticker -->
  <div class="ticker mt-14 lg:mt-20" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="ticker__row">
          {items.map((item) => (
            <span class="ticker__item">
              <span class="dot" />
              {item}
            </span>
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  import { initHeroField } from "../lib/hero-field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-field]");
  if (canvas) initHeroField(canvas);
</script>

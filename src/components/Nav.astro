---
import { ui, profile, type Lang } from "../data/content";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const links = [
  { href: "#capabilities", label: t(ui.nav.work, lang) },
  { href: "#impact", label: t(ui.nav.impact, lang) },
  { href: "#method", label: t(ui.nav.method, lang) },
  { href: "#cases", label: t(ui.nav.cases, lang) },
  { href: "#path", label: t(ui.nav.path, lang) },
  { href: "#contact", label: t(ui.nav.contact, lang) },
];

const otherLang = lang === "es" ? "/en/" : "/";
---

<header class="fixed inset-x-0 top-0 z-40" style="padding-top: env(safe-area-inset-top)">
  <div
    class="shell flex items-center justify-between gap-4 border-b border-line py-3 backdrop-blur-md"
    style="background: color-mix(in oklab, var(--c-bg) 82%, transparent)"
  >
    <a href="#top" class="flex items-center gap-3" aria-label={profile.name}>
      <span
        class="grid h-9 w-9 place-items-center border border-ink font-mono text-xs font-medium tracking-wider"
        aria-hidden="true">FS</span
      >
      <span class="hidden font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted sm:block">
        {profile.name} <span class="text-signal">/</span> AI&nbsp;Engineer
      </span>
    </a>

    <nav aria-label={lang === "es" ? "Secciones" : "Sections"} class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                data-spy
                class="nav-link font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted transition-colors hover:text-ink"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={otherLang}
        class="border border-line px-3 py-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted transition-colors hover:border-ink hover:text-ink"
        hreflang={lang === "es" ? "en" : "es"}
      >
        {lang === "es" ? "EN" : "ES"}
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-pressed="false"
        aria-label={t(ui.theme, lang)}
        class="grid h-9 w-9 place-items-center border border-line transition-colors hover:border-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8L6 18M18 6l1.8-1.8"
            stroke-linecap="round"></path>
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t(ui.menu, lang)}
        class="grid h-9 w-9 place-items-center border border-line transition-colors hover:border-ink lg:hidden"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="shell border-b border-line bg-bg lg:hidden">
    <ul class="flex flex-col py-2">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              data-menu-link
              class="block border-b border-line py-3 font-mono text-xs uppercase tracking-[0.16em] text-ink-soft last:border-0"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav-link[aria-current="true"] {
    color: var(--c-ink);
  }
  .nav-link[aria-current="true"]::after {
    content: "";
    display: block;
    height: 1px;
    margin-top: 0.3rem;
    background: var(--c-signal);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
  document.querySelectorAll("[data-menu-link]").forEach((l) => l.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

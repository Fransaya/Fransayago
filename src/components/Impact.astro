---
import { ui, metrics, type Lang } from "../data/content";
import { t } from "../lib/i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui.sections.impact;
---

<section id="impact" class="band bg-sunk">
  <div class="shell">
    <SectionHead
      index={s.index}
      label={t(s.label, lang)}
      title={t(s.title, lang)}
      lead={t(s.lead, lang)}
      aside={t(s.aside, lang)}
    />

    <dl class="mt-14 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        metrics.map((m, i) => (
          <div class="reveal flex flex-col gap-3 bg-bg p-7 lg:p-9" data-delay={i * 60}>
            <dt class="t-mono order-2">{t(m.label, lang)}</dt>
            <dd class="order-1 m-0">
              <span
                class="t-num font-display text-6xl font-black leading-none tracking-tight lg:text-7xl"
                data-count={m.value}
              >
                0
              </span>
              <span class="font-display text-4xl font-black leading-none text-signal lg:text-5xl">{m.suffix}</span>
            </dd>
            <dd class="order-3 m-0 border-t border-line pt-3 text-sm text-muted">{t(m.note, lang)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

---
import { ui, profile, type Lang } from "../data/content";
import { t } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui.sections.contact;

const channels = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}`, external: false },
  { label: "WhatsApp", value: profile.phone, href: profile.phoneHref, external: true },
  { label: "LinkedIn", value: profile.linkedinLabel, href: profile.linkedin, external: true },
  { label: "GitHub", value: profile.githubLabel, href: profile.github, external: true },
];
---

<section id="contact" class="band bg-sunk">
  <div class="shell">
    <div class="sec-index">
      <b>{s.index}</b>
      <span>{t(s.label, lang)}</span>
      <span>{t(s.aside, lang)}</span>
    </div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <h2 class="t-h2 reveal" data-kinetic>{t(s.title, lang)}</h2>
        <p class="t-lead reveal mt-6" data-delay="90">{t(s.lead, lang)}</p>

        <div class="reveal mt-8 flex flex-wrap gap-3" data-delay="140">
          <a href={`mailto:${profile.email}`} class="btn">
            {t(s.cta, lang)}
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a href={profile.cv} download class="btn btn--ghost">{t(s.cvCta, lang)}</a>
        </div>
      </div>

      <ul class="reveal grid gap-px self-start bg-line sm:grid-cols-2" data-delay="120">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? "_blank" : undefined}
                rel={c.external ? "noopener noreferrer" : undefined}
                class="flex h-full flex-col gap-2 bg-bg p-6 transition-colors hover:bg-signal-wash"
              >
                <span class="t-mono">{c.label}</span>
                <span class="t-num truncate text-lg font-semibold">{c.value}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a
      href={`mailto:${profile.email}`}
      class="reveal mt-16 block border-t border-line pt-10 lg:mt-24"
      data-delay="60"
    >
      <span
        class="block font-display text-[clamp(1.9rem,8.5vw,8rem)] font-black leading-[0.85] tracking-tight transition-colors [overflow-wrap:anywhere] hover:text-signal"
        data-kinetic
      >
        {profile.email}
      </span>
    </a>
  </div>
</section>

<footer class="border-t border-line">
  <div class="shell flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="t-mono t-num">
      © {new Date().getFullYear()} {profile.fullName} · {t(ui.footer.built, lang)}
    </p>
    <a href="#top" class="t-mono transition-colors hover:text-signal">↑ {t(ui.footer.top, lang)}</a>
  </div>
</footer>

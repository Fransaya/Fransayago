---
import { ui, cases, type Lang } from "../data/content";
import { t } from "../lib/i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui.sections.cases;
---

<section id="cases" class="band">
  <div class="shell">
    <SectionHead
      index={s.index}
      label={t(s.label, lang)}
      title={t(s.title, lang)}
      lead={t(s.lead, lang)}
      aside={t(s.aside, lang)}
    />

    <div class="mt-14 border-b border-line">
      {
        cases.map((c, i) => (
          <button
            type="button"
            class="case reveal"
            data-open-case={c.id}
            data-delay={i * 60}
            aria-haspopup="dialog"
            aria-label={`${t(s.open, lang)}: ${c.title}`}
          >
            <span class="t-mono t-num">{c.year}</span>

            <span class="flex flex-col gap-2">
              <span class="case__title font-display font-extrabold">{c.title}</span>
              <span class="t-mono">{t(c.context, lang)}</span>
            </span>

            <span class="flex flex-col gap-3">
              <span class="text-ink-soft">{t(c.headline, lang)}</span>
              <span class="flex flex-wrap gap-1.5">
                {t(c.tags, lang).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </span>
            </span>

            <span class="t-mono flex items-center gap-2 lg:justify-end" aria-hidden="true">
              <svg class="case__arrow h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 14L14 6M8 6h6v6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- case sheets -->
{
  cases.map((c) => (
    <dialog class="sheet" id={`case-${c.id}`} aria-labelledby={`case-${c.id}-title`}>
      <article class="p-6 sm:p-10 lg:p-14">
        <header class="flex items-start justify-between gap-6 border-b border-line pb-6">
          <div class="flex min-w-0 flex-col gap-2">
            <span class="t-mono t-num">
              {c.year} · {t(c.context, lang)}
            </span>
            <h2 id={`case-${c.id}-title`} class="text-4xl lg:text-5xl">
              {c.title}
            </h2>
            <p class="t-lead">{t(c.headline, lang)}</p>
          </div>
          <button
            type="button"
            data-close-case
            aria-label={t(s.close, lang)}
            class="grid h-10 w-10 flex-none place-items-center border border-line transition-colors hover:border-ink"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M3 3l10 10M13 3L3 13" stroke-linecap="round" />
            </svg>
          </button>
        </header>

        <div class="grid gap-10 pt-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
          <div class="flex flex-col gap-8">
            <section>
              <h3 class="t-mono mb-3 text-signal">{t(s.problem, lang)}</h3>
              <p class="text-ink-soft">{t(c.problem, lang)}</p>
            </section>

            <section>
              <h3 class="t-mono mb-3 text-signal">{t(s.decisions, lang)}</h3>
              <ul class="flex flex-col gap-3">
                {t(c.decisions, lang).map((d, i) => (
                  <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] items-start text-sm text-ink-soft">
                    <span class="t-num font-mono text-xs text-muted">{String(i + 1).padStart(2, "0")}</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
            </section>
          </div>

          <div class="flex flex-col gap-8">
            <section class="border border-line bg-surface p-6">
              <h3 class="t-mono mb-3 text-signal">{t(s.result, lang)}</h3>
              <ul class="flex flex-col gap-3">
                {t(c.result, lang).map((r) => (
                  <li class="flex items-start gap-3 text-sm">
                    <span class="dot mt-2" aria-hidden="true" />
                    <span class="t-num">{r}</span>
                  </li>
                ))}
              </ul>
            </section>

            <section>
              <h3 class="t-mono mb-3">{t(s.role, lang)}</h3>
              <p class="text-sm text-ink-soft">{t(c.role, lang)}</p>
            </section>

            <section>
              <h3 class="t-mono mb-3">{t(s.stack, lang)}</h3>
              <ul class="flex flex-wrap gap-1.5">
                {c.stack.map((tech) => (
                  <li class="chip" translate="no">
                    {tech}
                  </li>
                ))}
              </ul>
            </section>
          </div>
        </div>
      </article>
    </dialog>
  ))
}

<script>
  const dialogs = new Map<string, HTMLDialogElement>();
  document.querySelectorAll<HTMLDialogElement>("dialog.sheet").forEach((d) => dialogs.set(d.id, d));

  const lock = (on: boolean) => {
    document.body.style.overflow = on ? "hidden" : "";
  };

  const open = (id: string) => {
    const dialog = dialogs.get(id);
    if (!dialog || dialog.open) return;
    dialog.showModal();
    lock(true);
    // deep-linkable: the open case lives in the URL
    history.replaceState(null, "", `#${id}`);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-open-case]").forEach((btn) => {
    btn.addEventListener("click", () => open(`case-${btn.dataset.openCase}`));
  });

  dialogs.forEach((dialog) => {
    dialog.querySelector("[data-close-case]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      lock(false);
      if (location.hash === `#${dialog.id}`) history.replaceState(null, "", "#cases");
    });
    // click on the backdrop closes
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });

  // open straight from a shared link
  if (location.hash.startsWith("#case-")) open(location.hash.slice(1));
</script>

---
import { ui, method, type Lang } from "../data/content";
import { t } from "../lib/i18n";
import SectionHead from "./SectionHead.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui.sections.method;
---

<section id="method" class="band">
  <div class="shell">
    <SectionHead
      index={s.index}
      label={t(s.label, lang)}
      title={t(s.title, lang)}
      lead={t(s.lead, lang)}
      aside={t(s.aside, lang)}
    />

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
      <!-- sticky manifesto -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <figure class="reveal border-l-2 border-signal pl-6">
          <blockquote class="font-display text-2xl font-semibold leading-tight lg:text-3xl">
            “{t(s.quote, lang)}”
          </blockquote>
          <figcaption class="t-mono mt-4">
            Claude Code · Codex · {lang === "es" ? "code review propio" : "my own code review"}
          </figcaption>
        </figure>

        <div class="reveal mt-10 border border-line bg-surface p-6" data-delay="90">
          <h3 class="t-mono mb-4 text-ink">{t(s.guardTitle, lang)}</h3>
          <ul class="flex flex-col gap-3">
            {
              t(s.guards, lang).map((g) => (
                <li class="flex items-start gap-3 text-sm text-ink-soft">
                  <span class="mt-1.5 font-mono text-xs text-signal" aria-hidden="true">
                    ✕
                  </span>
                  <span>{g}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- steps -->
      <ol class="flex flex-col">
        {
          method.map((m, i) => (
            <li class="reveal grid grid-cols-[3rem_minmax(0,1fr)] gap-x-5 border-t border-line py-8" data-delay={i * 80}>
              <span class="font-display text-3xl font-black leading-none text-signal">{m.step}</span>
              <div class="flex flex-col gap-3">
                <h3 class="t-h3">{t(m.title, lang)}</h3>
                <p class="text-ink-soft">{t(m.body, lang)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

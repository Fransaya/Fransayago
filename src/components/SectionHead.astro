---
interface Props {
  index: string;
  label: string;
  title: string;
  lead: string;
  aside?: string;
  kinetic?: boolean;
}
const { index, label, title, lead, aside, kinetic = true } = Astro.props;
---

<div class="sec-index">
  <b>{index}</b>
  <span>{label}</span>
  {aside && <span>{aside}</span>}
</div>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:gap-16">
  <h2 class="t-h2 reveal" data-kinetic={kinetic ? "" : undefined}>{title}</h2>
  <p class="t-lead reveal" data-delay="90">{lead}</p>
</div>

---
import "../styles/tokens.css";
import { profile, type Lang } from "../data/content";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const site = "https://fransayago.vercel.app";
const path = lang === "es" ? "/" : "/en/";
const canonical = `${site}${path}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: "AI Engineer & Full Stack Developer",
  email: `mailto:${profile.email}`,
  url: canonical,
  address: { "@type": "PostalAddress", addressLocality: "Villa María", addressRegion: "Córdoba", addressCountry: "AR" },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: [
    "AI agents",
    "Prompt engineering",
    "Full stack development",
    "Data engineering",
    "Legacy modernization",
    "Software architecture",
  ],
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.fullName} />
    <meta name="theme-color" content="#f2efe9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={`${site}/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/`} />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={lang === "es" ? "es_AR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/profile-1000.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/profile-1000.jpg`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400..600&display=swap"
    />

    <script is:inline>
      // Theme before first paint — no flash.
      (() => {
        const stored = localStorage.getItem("theme");
        const system = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = stored === "light" || stored === "dark" ? stored : system;
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <noscript>
      <style>
        .reveal,
        .line-mask > span,
        [data-hero-fade] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>

  <body>
    <a class="skip-link" href="#main">
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>

    <div class="grain" aria-hidden="true"></div>

    <div class="fixed inset-x-0 top-0 z-50 h-[2px] bg-transparent" aria-hidden="true">
      <div data-progress class="h-full origin-left scale-x-0 bg-signal will-change-transform"></div>
    </div>

    <slot />

    <script>
      import { initMotion } from "../lib/motion";

      const boot = () => initMotion();
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
      } else {
        boot();
      }

      // Theme toggle
      const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        toggle.setAttribute("aria-pressed", String(next === "dark"));
      });
    </script>
  </body>
</html>
